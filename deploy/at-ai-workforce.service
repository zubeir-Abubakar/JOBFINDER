[Unit]
Description=AT AI Workforce
Documentation=file:///opt/at-ai-workforce/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atworkforce
Group=atworkforce
WorkingDirectory=/opt/at-ai-workforce
EnvironmentFile=/opt/at-ai-workforce/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/at-ai-workforce/data /opt/at-ai-workforce/.next/cache
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
