# Oracle production contract. Copy to /opt/at-ai-workforce/.env and replace placeholders.
# Never commit the resulting .env. Use mode 0600 and owner atworkforce.

APP_ENV=production
APP_SECRET_KEY=replace-with-openssl-rand-hex-32
# Required before exposing a fresh /setup page. At least 24 random characters.
# Generate with: openssl rand -base64 32
SETUP_TOKEN=
PORT=3000
DATA_DIR=/opt/at-ai-workforce/data
BACKUP_RETENTION_DAYS=30
# /api/health requires this bearer token in production, including direct host
# checks. Set HEALTH_PUBLIC=true only when nginx already restricts the route to
# loopback (the supplied nginx config does).
HEALTHCHECK_TOKEN=
HEALTH_PUBLIC=false

# nginx overwrites these headers. Do not enable this for a directly exposed app.
TRUST_PROXY=true
# Production must send HSTS; nginx terminates TLS and the app is only on loopback.
ENABLE_HSTS=true
# Never allow job/application fetches to reach private or metadata addresses.
OUTBOUND_ALLOW_PRIVATE=false
# Keep the recruitment pipeline non-submitting even if a stored setting is
# changed accidentally. The application also defaults to approval required and
# autonomous submission off.
RECRUITMENT_DRY_RUN=true

# Text inference. Point these at private, reachable services. localhost is valid
# only when the gateway/Ollama runs in the same container or host namespace.
AI_PRIMARY_PROVIDER=freellmapi
FREELLMAPI_ENABLED=true
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=replace-with-gateway-key
FREELLMAPI_MODEL=gpt-oss-20b
FREELLMAPI_ALLOWED_MODELS=gpt-oss-20b
FREELLMAPI_MODEL_ALIASES=openai/gpt-oss-20b,@cf/openai/gpt-oss-20b,openai-gpt-oss-20b,@cf/openai-gpt-oss-20b,groq/openai/gpt-oss-20b,ovh/gpt-oss-20b,cloudflare/@cf/openai/gpt-oss-20b,nvidia/openai/gpt-oss-20b
# Free-tier declarations. Leave false until the pinned model is confirmed to be
# covered by the account's free tier; an unverified provider is blocked.
GEMINI_FREE_TIER_VERIFIED=false
# JSON provider-evidence record required for text/vision. Live may instead use
# the explicit owner attestation below.
GEMINI_FREE_TIER_EVIDENCE=
# Text/vision owner attestation. This is not provider-issued billing evidence;
# strict evidence above still wins, and paid models/quota failures stay blocked.
GEMINI_FREE_TIER_ATTESTATION=
# Live-only owner attestation. Set to owner_confirmed only after checking AI
# Studio. This is not provider-issued billing evidence; key/model preflight and
# all quota/billing fail-closed checks still apply.
GEMINI_LIVE_FREE_TIER_ATTESTATION=
FREELLMAPI_FREE_TIER_VERIFIED=false
# JSON provider-evidence record. If empty, an explicit owner attestation may be
# used for the pinned non-billable model; all quota/billing guards still apply.
FREELLMAPI_FREE_TIER_EVIDENCE=
FREELLMAPI_FREE_TIER_ATTESTATION=
# Legacy setting, deliberately ignored. It cannot authorise paid Gemini Live,
# text or vision; all three require the declared free tier.
GEMINI_PAID_AUTHORISED=false
AI_BUDGET_LIMIT_CHF=0
AI_ALLOW_PAID_MODELS=false
AI_ALLOW_BILLING_FALLBACK=false
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=1
AI_RATE_LIMIT_DEFAULT_SECONDS=30
AI_QUEUE_MAX_ATTEMPTS=12

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=60000

# Gemini Live is voice-only and never a text fallback.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Charon
GEMINI_LIVE_API_VERSION=v1beta

FREELLMAPI_TTS_MODEL=gemini-2.5-flash-preview-tts
FREELLMAPI_TTS_VOICE=Charon
FREELLMAPI_STT_MODEL=whisper-1
FREELLMAPI_VOICE_ALLOWED_MODELS=gemini-2.5-flash-preview-tts,whisper-1

# OpenRouter text is opt-in and free-only. Keep the assignment list empty to
# preserve the existing eight-agent map. An assigned route never falls through
# to Ollama or a paid model.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_ASSIGNED_AGENTS=
OPENROUTER_MODEL_EXPIRES_AT=
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_ALLOW_CREDITS=false
OPENROUTER_ALLOW_AUTO_RECHARGE=false

# Chief speech. Only this exact free HeyGen model is allowed, restricted to the
# heygen provider. It retires 2026-11-30; the paid model is never substituted.
OPENROUTER_TTS_ENABLED=false
OPENROUTER_TTS_MODEL=heygen/heygen-voice-1-turbo:free
OPENROUTER_TTS_VOICE=nadine
OPENROUTER_TTS_PROVIDER=heygen
OPENROUTER_TTS_EXPIRES_AT=2026-11-30
TEMP_TTL_HOURS=24
TEMP_CLEANUP_INTERVAL_HOURS=6

GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

ASHBY_JOB_BOARDS=airapps,clickhouse
GREENHOUSE_BOARDS=sumup,adyen
LEVER_SITES=anybotics
EMPLOYER_CAREER_PAGES=
JOBS_CH_QUERIES=QA Engineer|Test Automation Engineer|SDET|QA Lead|Test Manager
GREENHOUSE_JOB_BOARD_API_KEY=
LEVER_POSTINGS_API_KEY=
ASHBY_API_KEY=

# Fail safe on a new host. The local database currently carries
# autonomous_submission=true, approval_mode=false and a 5/day cap; that policy
# must be explicitly reviewed and re-authorized before enabling live sending.
RECRUITMENT_SUBMISSION_ENABLED=false
RECRUITMENT_DRY_RUN=true

# Exact public origin used for traceable links in administrator emails.
# Use https://YOUR_DOMAIN (no path or trailing slash). Leave empty only when
# public links are intentionally unavailable; loopback is never used in email.
APP_BASE_URL=
RECRUITMENT_SCHEDULER=true
RECRUITMENT_CATCHUP_HOURS=6
RECRUITMENT_SUBMISSION_ENDPOINT=
CRON_SECRET=replace-with-openssl-rand-hex-32

# MFA is optional per account and is enrolled from Settings > Security. TOTP
# secrets and recovery-code hashes use APP_SECRET_KEY; changing that key makes
# enrolled authenticators unreadable. Reset MFA from Admin > Users if needed.
