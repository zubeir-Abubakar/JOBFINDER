# Oracle production contract. Copy to /opt/at-ai-workforce/.env and replace placeholders.
# Never commit the resulting .env. Use mode 0600 and owner atworkforce.

APP_ENV=production
APP_SECRET_KEY=replace-with-openssl-rand-hex-32
PORT=3000
DATA_DIR=/opt/at-ai-workforce/data
BACKUP_RETENTION_DAYS=30

# Text inference. Point these at private, reachable services. localhost is valid
# only when the gateway/Ollama runs in the same container or host namespace.
AI_PRIMARY_PROVIDER=freellmapi
FREELLMAPI_ENABLED=true
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=replace-with-gateway-key
FREELLMAPI_MODEL=gpt-oss-20b
FREELLMAPI_ALLOWED_MODELS=gpt-oss-20b
FREELLMAPI_MODEL_ALIASES=openai/gpt-oss-20b,@cf/openai/gpt-oss-20b,openai-gpt-oss-20b,@cf/openai-gpt-oss-20b,groq/openai/gpt-oss-20b,ovh/gpt-oss-20b,cloudflare/@cf/openai/gpt-oss-20b,nvidia/openai/gpt-oss-20b
AI_BUDGET_LIMIT_CHF=0
AI_ALLOW_PAID_MODELS=false
AI_ALLOW_BILLING_FALLBACK=false
AI_MAX_RETRIES=2
AI_MAX_CONCURRENCY=1
AI_RATE_LIMIT_DEFAULT_SECONDS=30
AI_QUEUE_MAX_ATTEMPTS=12

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=60000

# Gemini Live is voice-only and never a text fallback.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Charon
GEMINI_LIVE_API_VERSION=v1beta

FREELLMAPI_TTS_MODEL=gemini-2.5-flash-preview-tts
FREELLMAPI_TTS_VOICE=Charon
FREELLMAPI_STT_MODEL=whisper-1
FREELLMAPI_VOICE_ALLOWED_MODELS=gemini-2.5-flash-preview-tts,whisper-1
TEMP_TTL_HOURS=24
TEMP_CLEANUP_INTERVAL_HOURS=6

GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://at-ai-workforce.example.com/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

ASHBY_JOB_BOARDS=airapps,clickhouse
GREENHOUSE_BOARDS=sumup,adyen
LEVER_SITES=anybotics
EMPLOYER_CAREER_PAGES=
JOBS_CH_QUERIES=QA Engineer|Test Automation Engineer|SDET|QA Lead|Test Manager
GREENHOUSE_JOB_BOARD_API_KEY=
LEVER_POSTINGS_API_KEY=
ASHBY_API_KEY=

# Fail safe on a new host. The local database currently carries
# autonomous_submission=true, approval_mode=false and a 5/day cap; that policy
# must be explicitly reviewed and re-authorized before enabling live sending.
RECRUITMENT_SUBMISSION_ENABLED=false
RECRUITMENT_DRY_RUN=true
RECRUITMENT_SCHEDULER=true
RECRUITMENT_CATCHUP_HOURS=6
RECRUITMENT_SUBMISSION_ENDPOINT=
CRON_SECRET=replace-with-openssl-rand-hex-32
