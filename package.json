{
  "name": "at-ai-workforce",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "npm run e2e:prepare && playwright test --project=integration",
    "test:e2e": "npm run e2e:prepare && playwright test --project=desktop-chromium --project=mobile-chromium --project=auth-chromium --project=admin-chromium --project=schedules-chromium --project=visual-chromium --project=voice-chromium --project=setup",
    "test:voice": "npm run e2e:prepare && playwright test --project=voice-chromium",
    "test:regression": "npm run test:unit && npm run typecheck && npm run build && playwright test",
    "e2e:prepare": "npm run build",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:trace": "playwright show-trace",
    "dev": "next dev",
    "dev:https": "node scripts/dev-https.mjs",
    "dev:https:cert": "node scripts/dev-https.mjs --cert-only",
    "build": "next build",
    "start": "next start",
    "start:production": "node scripts/production-runtime.mjs",
    "start:production:detached": "node scripts/production-runtime.mjs --detach",
    "typecheck": "tsc --noEmit",
    "backup": "node scripts/backup.mjs",
    "backup:encrypt": "node scripts/encrypt-backup.mjs",
    "backup:decrypt": "node scripts/decrypt-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "secret-scan:history": "node scripts/secret-scan.mjs --history",
    "verify:remote": "node scripts/verify-remote-history.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/three": "^0.187.0",
    "docx": "^9.15.4",
    "docx-preview": "^0.4.1",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "undici": "^8.13.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": "true"
}
