+  .application-table tbody td:first-child::before,
+  .application-table tbody td:last-child::before { display: none; }
+  .application-table tbody td:last-child {
+    display: flex;
+    justify-content: flex-end;
+    padding-top: 8px !important;
+  }
+  .documents-table-body { padding: 0 12px 8px; }
+  .docs-data { min-width: 0; }
+  .docs-data thead { display: none; }
+  .docs-data tbody, .docs-data tr, .docs-data td { display: block; width: 100%; }
+  .docs-data tbody tr {
+    margin: 0 0 10px;
+    padding: 12px;
+    border: 1px solid var(--line);
+    border-radius: 14px;
+    background: color-mix(in oklab, var(--panel-2) 30%, transparent);
+  }
+  .docs-data tbody td {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 10px;
+    padding: 5px 0 !important;
+    border: 0 !important;
+    text-align: right;
+  }
+  .docs-data tbody td::before {
+    content: attr(data-label);
+    flex: 0 0 36%;
+    text-align: left;
+    color: var(--muted);
+    font-size: 9.5px;
+    font-weight: 600;
+    letter-spacing: .07em;
+    text-transform: uppercase;
+  }
+  .docs-data tbody td[data-label="Document"] {
+    display: block;
+    padding: 0 0 8px !important;
+    margin-bottom: 6px;
+    border-bottom: 1px solid var(--line) !important;
+    text-align: left;
+  }
+  .docs-data tbody td[data-label="Document"]::before,
+  .docs-data tbody td[data-label="Actions"]::before { display: none; }
+  .docs-data tbody td[data-label="Actions"] {
+    display: flex;
+    justify-content: flex-end;
+    padding-top: 8px !important;
+  }
+  .docs-data tbody td[data-label="Actions"] .row { justify-content: flex-end; width: 100%; }
+  .docs-data .doc-cell { min-width: 0; width: 100%; }
+  .docs-data .select-cell { justify-content: flex-start; }
+  .docs-data .select-cell::before { flex: 0 0 auto; margin-right: 8px; }
+  .docs-data .doc-cell .cell-title { white-space: normal; }
+}
+@media (max-width: 380px) {
+  .header-ai, .header-inbox { padding: 0 8px; gap: 0; }
+  .header-cta-label { display: none !important; }
+  .header-ai .agent-avatar { width: 25px !important; height: 25px !important; }
+}
+
+/* On-device diagnostics use plain, readable output so it is useful before
+   hydration or while React is failing. */
+.diag-pre {
+  margin: 0;
+  padding: 10px 12px;
+  max-height: 360px;
+  overflow: auto;
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  background: var(--panel-2);
+  color: var(--ink-soft);
+  font: 10.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
