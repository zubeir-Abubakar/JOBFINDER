# AT AI Workforce — environment configuration
# Copy to .env (or .env.local) and keep it out of version control.

# Optional first-run provisioning. No default password is seeded.
# Existing administrator accounts are migrated to abubakar@admin.com;
# a legacy default password must be changed after sign-in.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-this-password
ADMIN_EMAIL=abubakar@admin.com
ADMIN_PASSWORD=change-this-password

# First-run setup authorization. In production a token of at least 24 characters
# is required before /setup can create accounts. Never use a NEXT_PUBLIC_ name.
SETUP_TOKEN=

# AI provider — FreeLLMAPI is primary; Ollama is the local fallback for
# recoverable rate limits, outages, network errors and timeouts. Configuration
# and authentication errors fail closed. It runs locally (default 127.0.0.1:31415).
AI_PRIMARY_PROVIDER=freellmapi
FREELLMAPI_ENABLED=true
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
# A specific catalogued model id is required. "auto" is refused: the upstream
# model would be chosen after the request, so zero-cost routing cannot be enforced.
FREELLMAPI_MODEL=gpt-oss-20b
# The pinned model must be listed here explicitly. This allowlist can only narrow
# what is permitted: known billable vendor ids (claude, gpt-4/5, o1/o3/o4, ...)
# are refused even if listed, and no flag can widen the policy.
FREELLMAPI_ALLOWED_MODELS=gpt-oss-20b
# Optional comma-separated ids the gateway may report for the pinned model. It
# load-balances across providers and prefixes some ids (e.g. gpt-oss-120b is
# reported as both gpt-oss-120b and openai/gpt-oss-120b). Only declared aliases
# are accepted; any other resolved id is discarded. Billable or routing aliases
# are refused here too.
FREELLMAPI_MODEL_ALIASES=openai/gpt-oss-20b,@cf/openai/gpt-oss-20b,openai-gpt-oss-20b,@cf/openai-gpt-oss-20b,groq/openai/gpt-oss-20b,ovh/gpt-oss-20b,cloudflare/@cf/openai/gpt-oss-20b,nvidia/openai/gpt-oss-20b
# Cost is NOT verifiable: FreeLLMAPI publishes no pricing metadata, so usage is
# recorded with cost_status=unverified rather than a verified CHF 0.

AI_BUDGET_LIMIT_CHF=0
AI_MAX_RETRIES=2
AI_SEQUENTIAL_EXECUTION=true
# Shared concurrency cap for every FreeLLMAPI inference request (1–4).
# Interactive Coordinator calls are served before queued advisory work.
AI_MAX_CONCURRENCY=1
# Used only when the gateway gives no Retry-After or cooldown metadata.
AI_RATE_LIMIT_DEFAULT_SECONDS=30
# Advisory jobs are retried with backoff up to this many attempts.
AI_QUEUE_MAX_ATTEMPTS=12
AI_ALLOW_PAID_MODELS=false
AI_ALLOW_BILLING_FALLBACK=false

# Gemini/OpenRouter are not text fallbacks. GEMINI_API_KEY is used only by the
# dedicated Gemini Live voice session; voice audio never enters provider routing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Real-time voice only. This does not change the shared agent model above.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Charon
# Ephemeral-token Live endpoint version. Keep v1beta unless a proxy requires otherwise.
GEMINI_LIVE_API_VERSION=v1beta

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_ALLOW_CREDITS=false
OPENROUTER_ALLOW_AUTO_RECHARGE=false

# Local Ollama fallback. Enable only when the daemon and models are installed.
# General calls use OLLAMA_MODEL; coding-specific calls use OLLAMA_CODER_MODEL.
# The app never downloads a model automatically. For a remote deployment use a
# separately reachable, authenticated endpoint; never expose port 11434 publicly.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT_MS=60000

# Gmail OAuth (Google Cloud → APIs & Services → Credentials).
# Register exactly this redirect URI on the OAuth client.
GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# Required for encrypting Gmail tokens at rest.
APP_SECRET_KEY=

# Voice companion (server-side proxy; the key is never exposed to the browser)
FREELLMAPI_TTS_MODEL=gemini-2.5-flash-preview-tts
FREELLMAPI_TTS_VOICE=Charon
FREELLMAPI_STT_MODEL=whisper-1
# Voice has a separate pinned-model allowlist because it uses audio endpoints,
# not the text inference route. Cost remains unverified unless the gateway says otherwise.
FREELLMAPI_VOICE_ALLOWED_MODELS=gemini-2.5-flash-preview-tts,whisper-1
# Temporary cache: spoken-audio cache and other registered temp objects only
TEMP_TTL_HOURS=24
TEMP_CLEANUP_INTERVAL_HOURS=6
# Daily database + uploads backups kept on disk by `npm run backup`.
BACKUP_RETENTION_DAYS=30
# Off-host backup encryption. Prefer a 0600 file containing a base64 32-byte
# key; keep it separately from the backup destination. Never commit the key.
BACKUP_ENCRYPTION_KEY_FILE=
BACKUP_ENCRYPTION_KEY=

# /api/health is loopback-only by default. A private monitor may use a bearer
# token; HEALTH_PUBLIC=true is only for an endpoint protected elsewhere.
HEALTHCHECK_TOKEN=
HEALTH_PUBLIC=false

# Trust X-Real-IP / X-Forwarded-* only when a reverse proxy overwrites them.
# Leave false for direct development or a directly exposed app.
TRUST_PROXY=false
# HSTS is emitted automatically in production. Enable it locally only when you
# deliberately want to pin an HTTPS dev origin; never enable it for HTTP.
ENABLE_HSTS=false
# Outbound job/application URLs are public-only in production. Keep this false;
# local fixtures are allowed automatically under NODE_ENV=test/development.
OUTBOUND_ALLOW_PRIVATE=false

# --- Phase 2: autonomous recruitment -----------------------------------------
# Comma-separated Ashby board slugs (the part after jobs.ashbyhq.com/).
ASHBY_JOB_BOARDS=
# Comma-separated employer career pages that publish schema.org JobPosting data.
EMPLOYER_CAREER_PAGES=
# Comma-separated Greenhouse board tokens (the part after boards.greenhouse.io/).
GREENHOUSE_BOARDS=
# Comma-separated Lever site names (the part after jobs.lever.co/).
LEVER_SITES=
# Optional HTTP application form endpoint. Placeholders: {job_id} {application_url} {company}
# Leave empty to prepare packages and queue submission for a human instead.
RECRUITMENT_SUBMISSION_ENDPOINT=
RECRUITMENT_SUBMISSION_ENABLED=true
# Prepare and verify everything but send nothing.
RECRUITMENT_DRY_RUN=false
# The in-process scheduler ticks every minute and reads the persisted schedule.
RECRUITMENT_SCHEDULER=true
# A run that is late by more than this many hours is recorded as missed, not executed late.
RECRUITMENT_CATCHUP_HOURS=6
# Bearer token required by /api/cron/recruitment when calling it from a platform cron.
CRON_SECRET=

# ATS submission credentials are EMPLOYER-ISSUED, not candidate credentials.
# Greenhouse: Job Board API key (HTTP Basic). Lever: postings key from the
# employer's Lever Super Admin. Ashby: key with candidatesWrite plus the
# employer's form definition. Leave empty unless an employer has issued one;
# without it the package is queued for the employer's hosted form.
GREENHOUSE_JOB_BOARD_API_KEY=
LEVER_POSTINGS_API_KEY=
ASHBY_API_KEY=

# Verified jobs.ch public search queries, pipe-separated. The connector fetches
# the search JSON and the schema.org JobPosting detail, so no key is required.
JOBS_CH_QUERIES=QA Engineer|Test Automation Engineer|SDET|QA Lead|Test Manager

# Visual understanding (screenshots). Screen frames are sent only after the
# owner explicitly clicks "Ask about this screen". GPT-OSS-20B is text-only.
VISION_ENABLED=true
# Optional override; defaults to GEMINI_MODEL.
# VISION_MODEL=gemini-3.8-flash
