# AT AI Workforce — environment configuration
# Copy to .env (or .env.local) and keep it out of version control.

# Optional first-run provisioning. No default password is seeded.
# Existing administrator accounts are migrated to abubakar@admin.com;
# a legacy default password must be changed after sign-in.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-this-password
ADMIN_EMAIL=abubakar@admin.com
ADMIN_PASSWORD=change-this-password

# AI providers — one shared service. Priority: Gemini → OpenRouter free → Ollama.
AI_BUDGET_LIMIT_CHF=0
AI_PRIMARY_PROVIDER=gemini
AI_MAX_RETRIES=2
AI_SEQUENTIAL_EXECUTION=true
AI_ALLOW_PAID_MODELS=false
AI_ALLOW_BILLING_FALLBACK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_ALLOW_CREDITS=false
OPENROUTER_ALLOW_AUTO_RECHARGE=false

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:1.5b

# Gmail OAuth (Google Cloud → APIs & Services → Credentials).
# Register exactly this redirect URI on the OAuth client.
GMAIL_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send

# Required for encrypting Gmail tokens at rest.
APP_SECRET_KEY=
